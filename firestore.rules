rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() 
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == role;
    }

    match /users/{userId} {
      allow read: if true; 
      allow create: if isOwner(userId);
      
      // Allow updates to prepaid_balance only via authorized transactions
      allow update: if isOwner(userId) 
                    || hasRole('admin') 
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prepaid_balance', 'partners', 'commission_balance', 'vouchers', 'updatedAt'])); 
      
      allow delete: if hasRole('admin');

      match /kids/{kidId} {
        allow read, write: if isOwner(userId) || hasRole('admin');
      }

      match /medicalDocs/{docId} {
        allow read, write: if isOwner(userId) || hasRole('admin');
      }
      
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || hasRole('admin');
        allow create: if isAuthenticated(); 
      }

      match /vouchers/{voucherId} {
        allow read, write, list: if isOwner(userId) || hasRole('admin');
      }

      match /support_idempotency/{id} {
        allow read, write: if isOwner(userId);
      }
    }

    match /nfcApplications/{appId} {
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      allow get: if isAuthenticated() 
                 && (resource.data.userId == request.auth.uid 
                     || hasRole('admin'));
      allow list: if (isAuthenticated() && request.auth.uid in request.query.filters.userId)
                  || hasRole('admin');
      allow update: if hasRole('admin');
      allow delete: if hasRole('admin');
    }

    match /crowdfundingRequests/{requestId} {
      allow get: if resource.data.status == 'live' || hasRole('admin') || isOwner(resource.data.requesterId);
      allow list: if request.query.filters.status == 'live'
                  || hasRole('admin')
                  || (isAuthenticated() && request.query.filters.requesterId == request.auth.uid);
      allow create: if isAuthenticated() 
                    && request.resource.data.requesterId == request.auth.uid;
      allow update: if hasRole('admin') 
                    || isOwner(resource.data.requesterId);
      allow delete: if hasRole('admin');
    }

    match /payoutRequests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.agentUid == request.auth.uid;
      allow read, list: if hasRole('admin') || (isAuthenticated() && resource.data.agentUid == request.auth.uid);
      allow update: if hasRole('admin');
      allow delete: if hasRole('admin');
    }

    match /debitOrderRequests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update: if hasRole('admin') || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    match /pendingAgentApplications/{id} {
      allow create: if true;
      allow list: if hasRole('admin') || (request.query.limit <= 5 && request.query.filters.email != null);
      allow read, update: if hasRole('admin');
    }

    match /pendingPartnerApplications/{id} {
      allow create: if true;
      allow list: if hasRole('admin') || (request.query.limit <= 5 && request.query.filters.email != null);
      allow read, update: if hasRole('admin');
    }

    match /uatProgress/{flowId} {
      allow read, write: if hasRole('admin');
    }
    
    match /rateLimitLog/{logId} {
      allow create: if true;
      allow read: if hasRole('admin');
    }

    match /mail/{mailId} {
      allow create: if true;
    }

    match /emailLog/{logId} {
      allow create: if true;
      allow read: if hasRole('admin');
    }
    
    match /consentLog/{logId} {
      allow create: if isAuthenticated();
      allow read: if hasRole('admin');
    }
  }
}
