rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is the owner of the path UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check user role from the Firestore 'users' collection
    function hasRole(role) {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // 1. Profile Photos: Only owner can read/write. Enforce MIME: JPG, PNG, WebP.
    match /profilePhotos/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) 
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    // 2. Medical Docs: Only owner can read/write. Enforce MIME: JPG, PNG, PDF.
    match /medicalDocs/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) 
        && request.resource.contentType.matches('image/(jpeg|png)|application/pdf')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    // 3. Crowdfunding: Only owner can upload. Public read for active campaigns. Enforce MIME: Video.
    match /crowdfunding/{uid}/{fileName} {
      allow write: if isOwner(uid) 
        && request.resource.contentType.matches('video/.*')
        && request.resource.size <= 20 * 1024 * 1024;
      allow read: if true;
    }

    // 4. Agent Applications: Admin-only read. Writes disabled (handled via Firestore first).
    match /agent-applications/{fileName} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    // 5. Partner Applications: Admin-only read. Writes disabled.
    match /partner-applications/{fileName} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    // 6. Global Catch-all: Deny all unauthenticated writes and default to auth-read.
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
